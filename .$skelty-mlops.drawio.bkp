  <diagram name="Mapping paper - PoC" id="mapPaperPoc01">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="m101" value="&lt;b&gt;Mapping: SkeltyMLOps data-drift scenario (paper, Section 5.9, Fig. 7) to the PoC&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="m102" value="&lt;b&gt;Paper&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="380" height="30" as="geometry" />
        </mxCell>
        <mxCell id="m103" value="&lt;b&gt;PoC realisation&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="520" y="70" width="600" height="30" as="geometry" />
        </mxCell>
        <mxCell id="m104" value="&lt;b&gt;Evidence&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1220" y="70" width="380" height="30" as="geometry" />
        </mxCell>
        <mxCell id="m105" value="&lt;b&gt;Step 1 - Drift detection&lt;/b&gt;&lt;br&gt;Deployment &amp;amp; Monitoring emits DRIFT_DETECTED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="380" height="84" as="geometry" />
        </mxCell>
        <mxCell id="m106" value="&lt;b&gt;Reduced&lt;/b&gt;&lt;br&gt;CronJob skelty-drift-check (every 5 min) reads /stats and compares with reference_stats.json. Drift if at least 3 features have z &amp;gt; 1.0 and n &amp;gt;= 100." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="520" y="110" width="600" height="84" as="geometry" />
        </mxCell>
        <mxCell id="m107" value="Scenario log, step 3: all six features drifted. CronJob pod log." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;spacingLeft=8;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1220" y="110" width="380" height="84" as="geometry" />
        </mxCell>
        <mxCell id="m108" style="endArrow=classic;html=1;strokeWidth=2;endSize=8;" edge="1" parent="1" source="m105" target="m106">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m109" style="endArrow=classic;html=1;strokeWidth=2;endSize=8;" edge="1" parent="1" source="m106" target="m107">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m110" value="&lt;b&gt;Step 2 - Ticket creation&lt;/b&gt;&lt;br&gt;MPO creates a ticket bound to contract drift-response-v1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="212" width="380" height="84" as="geometry" />
        </mxCell>
        <mxCell id="m111" value="&lt;b&gt;Reduced&lt;/b&gt;&lt;br&gt;The monitor itself creates a GitHub Issue [drift] with label retrain and a JSON body (type, model_version, drifted_features, detected_at). Skipped if a retrain issue is already open. No contract." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="520" y="212" width="600" height="84" as="geometry" />
        </mxCell>
        <mxCell id="m112" value="Issue #7 created at 12:10:34Z, 2 min 41 s after the shifted data." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;spacingLeft=8;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1220" y="212" width="380" height="84" as="geometry" />
        </mxCell>
        <mxCell id="m113" style="endArrow=classic;html=1;strokeWidth=2;endSize=8;" edge="1" parent="1" source="m110" target="m111">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m114" style="endArrow=classic;html=1;strokeWidth=2;endSize=8;" edge="1" parent="1" source="m111" target="m112">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m115" value="&lt;b&gt;Step 3 - Plan approval&lt;/b&gt;&lt;br&gt;Product Owner reviews, approves and sets priority (human gate)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="314" width="380" height="84" as="geometry" />
        </mxCell>
        <mxCell id="m116" value="&lt;b&gt;Not implemented&lt;/b&gt;&lt;br&gt;No approval and no priority. The orchestrator accepts every ticket automatically and marks it in-progress." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="520" y="314" width="600" height="84" as="geometry" />

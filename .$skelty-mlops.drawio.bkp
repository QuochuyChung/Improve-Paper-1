        <mxCell id="m117" value="-" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;spacingLeft=8;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">

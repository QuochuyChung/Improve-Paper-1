        <mxCell id="m120" value="&lt;b&gt;Step 4 - Dataset update&lt;/b&gt;&lt;br&gt;Data Engineer collects, labels, validates, registers dataset-v3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="416" width="380" height="84" as="geometry" />
        </mxCell>
        <mxCell id="m121" value="&lt;b&gt;Simulated&lt;/b&gt;&lt;br&gt;Argo steps acquire.py and process.py generate synthetic data and write /data/raw and /data/features by run id, with SHA-256 in manifest.json. No labelling, no Data Engineer." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="520" y="416" width="600" height="84" as="geometry" />

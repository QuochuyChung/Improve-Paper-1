        <mxCell id="m127" value="train log: run-id issue-7, accuracy 0.915, F1 0.9163." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;spacingLeft=8;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
